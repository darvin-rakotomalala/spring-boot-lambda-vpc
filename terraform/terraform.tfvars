# ─── Adjust for your environment ────────────────────────────────────
primary_region = "us-east-1"
environment    = "dev"
project_name   = "ce"
team_name      = "training"
cost_center    = "engineering"
compliance     = "internal"
github_org     = "darvin-rakotomalala"
github_repo    = "spring-boot-lambda-vpc"
bucket_name    = "ce-dev-terraform-state-69127"
lambda_environment = {
  SPRING_PROFILES_ACTIVE = "lambda"
}
vpc_cidr                      = "18.25.15.0/25"
availability_zones            = ["us-east-1a", "us-east-1b", "us-east-1c"]
subnet_newbits                = 2
interface_endpoint_services   = ["secretsmanager", "logs"]
log_retention_days            = 14
alarm_email                   = "darvintojo@gmail.com"
db_name                       = "lambdaappdb"
db_username                   = "appadmin"
db_engine_version             = "16"
db_parameter_group_family     = "postgres16"
db_instance_class             = "db.t4g.medium"
db_allocated_storage          = 20
db_max_allocated_storage      = 200
db_multi_az                   = true
db_backup_retention_days      = 7
proxy_max_connections_percent = 90
lambda_handler                = "com.ce.StreamLambdaHandler::handleRequest"
lambda_memory_mb              = 1536
lambda_timeout_s              = 29
lambda_architecture           = "arm64"
lambda_reserved_concurrency   = -1
latency_strategy              = "snapstart"
pc_min_capacity               = 5
pc_max_capacity               = 50
pc_target_utilization         = 0.7
api_5xx_threshold             = 5
api_4xx_threshold             = 50
min_success_rate_percent      = 99
api_authorization             = "NONE"
api_throttle_rate             = 100
api_throttle_burst            = 200
create_apigw_account_role     = true
